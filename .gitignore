# Local tools, caches and editor state.
.DS_Store
*.log
*.pyc
__pycache__/
*.iml
.idea/
.vscode/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
coverage/
# Delivery provenance is regenerated from Git after pulls and native builds.
# Keep it in portable exports, without dirtying the checkout after every pull.
/studio/assets/visual_uploads.json
.gradle/
.kotlin/
.cxx/
.swiftpm/
DerivedData/
xcuserdata/

# Portable exports are outputs, not the source repository.
/dist/

# Keep application lockfiles; library locks are consumer-specific.
/packages/*/pubspec.lock

# Native machine-generated files.
Pods/
.symlinks/
**/ios/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/.last_build_id
**/ios/Runner/GeneratedPluginRegistrant.*
**/android/local.properties
**/android/key.properties
**/*.jks
**/*.keystore

# Generated catalog source, JSON, shaders, thumbnails and signal fixtures are
# deliberately tracked so CI can detect generation drift.
